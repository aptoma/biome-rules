{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"plugins": [
		{
			"path": "./node_modules/@aptoma/biome-rules/rules/no-chained-type-assertions.ts",
			"includes": ["**", "!**/*.test.*", "!**/test/**"]
		},
		"./node_modules/@aptoma/biome-rules/rules/no-widen-then-assert.ts",
		"./node_modules/@aptoma/biome-rules/rules/no-object-parameters.ts",
		"./node_modules/@aptoma/biome-rules/rules/no-unknown-returns.ts",
		"./node_modules/@aptoma/biome-rules/rules/no-known-value-widening.ts"
	]
}
